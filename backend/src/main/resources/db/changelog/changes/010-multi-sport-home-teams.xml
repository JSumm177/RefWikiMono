<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="13" author="admin">
        <createTable tableName="user_home_teams">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_uht_user" referencedTableName="users" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="sport_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_uht_sport" referencedTableName="sports" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="team_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="user_home_teams" columnNames="user_id, sport_id" constraintName="uq_user_sport_team"/>

        <dropColumn tableName="user_profiles" columnName="home_team"/>
    </changeSet>

</databaseChangeLog>
