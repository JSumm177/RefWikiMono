<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="5" author="admin">
        <createTable tableName="sports">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <createTable tableName="rulebooks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sport_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_rulebook_sport" referencedTableName="sports" referencedColumnNames="id"/>
            </column>
            <column name="release_year" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="source_url" type="VARCHAR(500)"/>
        </createTable>

        <createTable tableName="rules">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rulebook_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_rule_rulebook" referencedTableName="rulebooks" referencedColumnNames="id"/>
            </column>
            <column name="rule_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="sections">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rule_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_section_rule" referencedTableName="rules" referencedColumnNames="id"/>
            </column>
            <column name="section_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="articles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="section_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_article_section" referencedTableName="sections" referencedColumnNames="id"/>
            </column>
            <column name="article_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="text" type="LONGTEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <modifySql dbms="mysql">
            <append value=" ENGINE=InnoDB CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"/>
        </modifySql>
    </changeSet>

    <changeSet id="6" author="admin" dbms="mysql">
        <sql>
            ALTER TABLE articles ADD FULLTEXT INDEX article_text_fulltext (text);
        </sql>
    </changeSet>

</databaseChangeLog>
