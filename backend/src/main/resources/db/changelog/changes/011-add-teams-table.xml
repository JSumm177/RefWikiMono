<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="14" author="admin">
        <createTable tableName="teams">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sport_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_team_sport" referencedTableName="sports" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="VARCHAR(100)"/>
            <column name="abbreviation" type="VARCHAR(10)"/>
        </createTable>

        <addUniqueConstraint tableName="teams" columnNames="sport_id, name" constraintName="uq_sport_team_name"/>
    </changeSet>

</databaseChangeLog>
