{
  "name": "refwiki-mono",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "mobile"
  ],
  "description": "A fullstack monorepo featuring a React TypeScript frontend, a Java Servlet backend with MySQL, and a React Native mobile application.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "docs:build": "honkit build docs && touch docs/_book/.nojekyll",
    "docs:serve": "honkit serve docs",
    "dev": "./start-dev.sh",
    "fix:links": "cd mobile && npx react-native-monorepo-tools-fix-links || true",
    "postinstall": "npm run fix:links"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSumm177/RefWikiMono.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/JSumm177/RefWikiMono/issues"
  },
  "homepage": "https://github.com/JSumm177/RefWikiMono#readme",
  "devDependencies": {
    "honkit": "^6.1.7",
    "wait-on": "^9.0.4",
    "@react-native/metro-config": "0.83.4",
    "@react-native-community/cli": "15.1.3"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "overrides": {
    "react-native": "0.83.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native-screens": "4.23.0",
    "react-native-safe-area-context": "5.6.2",
    "@react-native/assets-registry": "0.83.4",
    "@react-native/codegen": "0.83.4",
    "@react-native/community-cli-plugin": "0.83.4",
    "@react-native/gradle-plugin": "0.83.4",
    "@react-native/js-polyfills": "0.83.4",
    "@react-native/normalize-colors": "0.83.4",
    "@react-native/virtualized-lists": "0.83.4",
    "@react-native/metro-config": "0.83.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "15.1.3",
    "@react-native-community/cli-platform-android": "15.1.3",
    "@react-native-community/cli-platform-ios": "15.1.3",
    "axios": "^1.15.0",
    "http-proxy-agent": "^7.0.0",
    "https-proxy-agent": "^7.0.0",
    "jsdom": {
      "http-proxy-agent": "^7.0.0",
      "https-proxy-agent": "^7.0.0"
    }
  }
}
